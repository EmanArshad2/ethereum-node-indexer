# Blockscout Environment Configuration - Sepolia Testnet (Live-Only Mode)

# Network Metadata
CHAIN_NAME=Sepolia
CHAIN_ID=11155111
COIN=ETH

# RPC Endpoint Connection (pointing to local Geth instance)
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_HTTP_URL=http://host.docker.internal:8545
ETHEREUM_JSONRPC_TRACE_URL=http://host.docker.internal:8545
ETHEREUM_JSONRPC_WS_URL=ws://host.docker.internal:8546

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:blockscout_db_password@db:5432/blockscout
ECTO_USE_SSL=false

# Server Settings
PORT=4000
SECRET_KEY_BASE=5665606565656565656565656565656565656565656565656565656565656565

# INDEXER OPERATIONAL MODE: LIVE-ONLY MODE
# Setting FIRST_BLOCK to 'latest' indexes incoming new blocks from head forward immediately
INDEXER_DISABLE_PENDING_TRANSACTIONS_INDEXER=false
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_INDEXER=false
FIRST_BLOCK=latest
INDEXER_DISABLE_HISTORICAL_INDEXING=true
