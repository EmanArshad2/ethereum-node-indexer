# Blockscout Environment Configuration - Ethereum Mainnet (Live-Only Mode)

# Network Metadata
CHAIN_NAME=Ethereum Mainnet
CHAIN_ID=1
COIN=ETH

# RPC Endpoint Connection (pointing to high-speed public Mainnet RPC)
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_HTTP_URL=https://ethereum-rpc.publicnode.com

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:blockscout_db_password@db:5432/blockscout
ECTO_USE_SSL=false

# Server Settings
PORT=4000
SECRET_KEY_BASE=7765606565656565656565656565656565656565656565656565656565656577

# INDEXER OPERATIONAL MODE: LIVE-ONLY MODE
INDEXER_DISABLE_PENDING_TRANSACTIONS_INDEXER=true
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_INDEXER=true
FIRST_BLOCK=latest
INDEXER_DISABLE_HISTORICAL_INDEXING=false
