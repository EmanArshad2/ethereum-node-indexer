[Unit]
Description=Ethereum Node & Blockscout Monitoring Daemon
After=network.target geth-mainnet.service lighthouse-mainnet.service
Wants=network-online.target

[Service]
User=root
Type=simple
Restart=always
RestartSec=10
ExecStart=/usr/bin/python3 /opt/ethereum/scripts/monitor-alerts.py --daemon --interval 60

[Install]
WantedBy=multi-user.target
