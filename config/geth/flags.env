# Geth Execution Client Environment Configuration
# Location: /etc/ethereum/geth.env (or included directly in systemd unit)

GETH_DATA_DIR=/var/lib/ethereum/geth
JWT_SECRET_PATH=/var/lib/ethereum/jwt.hex

# Performance & Sync Tuning
GETH_CACHE=8192
GETH_MAXPEERS=50
GETH_SYNCMODE=snap

# HTTP RPC Options (Blockscout and local queries)
GETH_HTTP_HOST=0.0.0.0
GETH_HTTP_PORT=8545
GETH_HTTP_API=eth,net,web3,engine,txpool,debug

# WebSocket Options
GETH_WS_HOST=0.0.0.0
GETH_WS_PORT=8546
GETH_WS_API=eth,net,web3

# Engine API Options (Authenticated via JWT for Lighthouse)
GETH_AUTHRPC_HOST=127.0.0.1
GETH_AUTHRPC_PORT=8551
