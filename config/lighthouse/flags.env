# Lighthouse Consensus Client Environment Configuration
# Location: /etc/ethereum/lighthouse.env

LIGHTHOUSE_DATA_DIR=/var/lib/ethereum/lighthouse
JWT_SECRET_PATH=/var/lib/ethereum/jwt.hex
EXECUTION_ENGINE_ENDPOINT=http://127.0.0.1:8551

# Checkpoint Sync Endpoints (Instant beacon state sync)
SEPOLIA_CHECKPOINT_SYNC=https://checkpoint-sync.sepolia.ethpandaops.io
MAINNET_CHECKPOINT_SYNC=https://mainnet-checkpoint-sync.attestant.io

# Lighthouse REST API Options
LIGHTHOUSE_HTTP_HOST=0.0.0.0
LIGHTHOUSE_HTTP_PORT=5052
LIGHTHOUSE_PORT=9000
