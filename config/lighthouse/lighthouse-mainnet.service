[Unit]
Description=Lighthouse Beacon Node (Ethereum Mainnet)
After=network.target network-online.target geth-mainnet.service
Wants=network-online.target

[Service]
User=ethereum
Group=ethereum
Type=simple
Restart=always
RestartSec=5
ExecStart=/usr/local/bin/lighthouse bn \
  --network mainnet \
  --datadir /var/lib/ethereum/lighthouse-mainnet \
  --execution-endpoint http://127.0.0.1:8551 \
  --execution-jwt /var/lib/ethereum/jwt.hex \
  --checkpoint-sync-url https://mainnet-checkpoint-sync.attestant.io \
  --http \
  --http-address 0.0.0.0 \
  --http-port 5052 \
  --http-allow-origin "*" \
  --port 9000

KillMode=process
TimeoutStopSec=60
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
